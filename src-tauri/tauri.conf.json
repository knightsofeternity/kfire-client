{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KFIRE",
  "version": "0.9.1",
  "identifier": "app.kfire.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KFIRE",
        "width": 420,
        "height": 560,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBN0NGMjM4QUNERTZBQkIKUldTN2F0NnNPUEo4bWxNNVowMkNzUW5zeXdSRUNUTSsxaHJaOVR0R0J5cWo0Y0tVRGxjdzAwR3YK",
      "endpoints": [
        "https://github.com/knightsofeternity/kfire-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
